# Copier vers .env puis remplir les valeurs. Voir src/lib/env.ts (validation Zod au démarrage).
# Ne jamais commiter un vrai .env.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base PostgreSQL (requis)
DATABASE_URL=postgresql://user:password@localhost:5432/simon_morin_crm

# Secret de session : min 32 caractères, aléatoire. Générer avec : openssl rand -base64 48
SESSION_SECRET=change-moi-avec-une-valeur-aleatoire-d-au-moins-32-caracteres

# Google Calendar (optionnel — l'app dégrade proprement sans)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_MAPS_API_KEY=

# Divers
APP_TIME_ZONE=America/Toronto
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_EMAIL=
PUBLIC_MESSENGER_URL=

# Meta / Facebook (optionnel)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_PAGE_URL=
META_GRAPH_API_VERSION=v20.0
META_VERIFY_TOKEN=
META_TOKEN_ENCRYPTION_KEY=

# Import Gestion ISR (optionnel — défaut : https://location.gestion-isr.com/)
GESTION_ISR_LISTINGS_URL=

# Seed de démonstration UNIQUEMENT (jamais en production) :
# le compte admin demo.admin@fictif.local n'est créé que si cette variable est définie (min 12 caractères).
SEED_ADMIN_PASSWORD=
